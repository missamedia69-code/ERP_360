<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Thème natif minimal pour une app 100% Compose.
      Aucune ActionBar (Compose gère toute l'UI) et couleurs gérées
      côté Jetpack Compose (ui/theme/Theme.kt).
    -->
    <style name="Theme.ERP360" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Évite un écran noir entre deux compositions, notamment lors d'un changement de langue. -->
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
