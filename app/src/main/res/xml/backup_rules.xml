<?xml version="1.0" encoding="utf-8"?>
<!--
    Sauvegarde Google (Auto Backup) — Android 11 (API 30) et antérieurs.
    `android:fullBackupContent` pointe ici ; à partir d'Android 12, ce sont les
    règles de `data_extraction_rules.xml` qui s'appliquent.

    L'application promet qu'aucune donnée ne quitte le téléphone. Rien de ce
    qu'elle produit ne doit donc être téléversé chez Google :

    * la base Room — clients, pièces, trésorerie, journal, licence ;
    * ses fichiers annexes WAL et SHM, qui contiennent les mêmes données ;
    * les réglages DataStore, dont l'empreinte du PIN (le PIN lui-même n'est
      jamais stocké) ;
    * le dossier `backups/`, où la sauvegarde quotidienne dépose une copie
      complète de la base : sans cette exclusion, elle serait envoyée telle
      quelle dans le cloud.

    Le transfert direct d'un téléphone à l'autre reste autorisé (voir
    `data_extraction_rules.xml`) : c'est une migration voulue par l'utilisateur,
    pas une copie déposée dans le cloud. La restauration manuelle
    (Admin › Sauvegarde, ou fichier produit par `BackupManager`) reste le moyen
    prévu pour réinstaller les données.
-->
<full-backup-content>
    <exclude domain="database" path="missa_b360.db" />
    <exclude domain="database" path="missa_b360.db-wal" />
    <exclude domain="database" path="missa_b360.db-shm" />
    <exclude domain="database" path="missa_b360.db-journal" />
    <exclude domain="file" path="datastore" />
    <exclude domain="file" path="backups" />
</full-backup-content>
